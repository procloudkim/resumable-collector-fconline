* text=auto eol=lf
*.sqlite3 filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.db filter=lfs diff=lfs merge=lfs -text
*.sqlite filter=lfs diff=lfs merge=lfs -text

## Enforce LF for Python sources (cross-platform consistency)
*.py text eol=lf

## Windows-only scripts use CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf

## Common text formats (explicit LF for safety)
*.txt  text eol=lf
*.csv  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
